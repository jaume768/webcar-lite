# ---------------------------------------------------------------------------
# Copia este fichero a .env y ajusta lo que necesites.
#   cp .env.example .env
# En dev los valores por defecto funcionan tal cual contra docker compose.
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
# Clave de firma. En produccion, obligatoria y unica por instalacion:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-inseguro-cambiar-en-produccion
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
# Lista separada por comas. En prod nunca "*".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Origenes de confianza para CSRF en prod (con esquema): https://crm.ejemplo.es
DJANGO_CSRF_TRUSTED_ORIGINS=
# plain (consola legible) o json (para agregadores de logs)
DJANGO_LOG_FORMAT=plain
DJANGO_LOG_LEVEL=INFO
# Barra de debug de Django en dev. No activar en prod.
DJANGO_DEBUG_TOOLBAR=False

# --- Base de datos ---------------------------------------------------------
# Postgres 16 siempre, tambien en tests. El dominio usa tstzrange y btree_gist.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
# Puerto publicado en el host (cambialo si ya tienes un Postgres local).
POSTGRES_PORT=5432
DATABASE_URL=postgres://crm:crm@db:5432/crm
# Segundos de reutilizacion de conexion. 0 en dev, 60 en prod tras pgbouncer.
DATABASE_CONN_MAX_AGE=0

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# True ejecuta las tareas en el propio proceso web (util sin worker levantado).
CELERY_TASK_ALWAYS_EAGER=False

# --- Servidor web ----------------------------------------------------------
# Puerto publicado en el host para la app.
WEB_PORT=8000

# --- Ficheros --------------------------------------------------------------
# Documentos de clientes (carnet, DNI). No se sirven por URL: los entrega una
# vista que comprueba permisos. Por defecto ./private-media dentro del proyecto.
DJANGO_PRIVATE_MEDIA_ROOT=
# Tamano maximo por fichero subido, en MB.
MAX_UPLOAD_SIZE_MB=10

# --- Dominio ---------------------------------------------------------------
# Cada cuantos segundos se refresca solo el panel de mostrador.
DASHBOARD_REFRESH_SECONDS=120

# --- Cargos de devolucion --------------------------------------------------
# Precio por kilometro pasado del limite incluido.
EXTRA_KM_PRICE=0.15
# Precio del litro para cobrar el combustible que falta.
FUEL_PRICE_PER_LITER=1.60
# Deposito por defecto, en litros, si el vehiculo no lo tiene informado.
DEFAULT_TANK_LITERS=50
# Donde queda el coche al devolverlo: cleaning o available.
VEHICLE_STATUS_AFTER_CHECKOUT=cleaning

# Formato del numero de reserva: {year} y {sequence}. Con {year}, la serie se
# reinicia cada ano. Cambiarlo no renumera lo ya emitido.
RESERVATION_NUMBER_FORMAT=R{year}-{sequence:05d}
# Fianza y franquicia por defecto, en euros.
RESERVATION_DEFAULT_DEPOSIT=150.00
RESERVATION_DEFAULT_FRANCHISE=600.00

# Minutos de limpieza y revision entre dos alquileres del mismo vehiculo.
# Cuentan como ocupacion: con 60, un coche devuelto a las 10:00 no se puede
# volver a entregar hasta las 11:00.
VEHICLE_ROTATION_MINUTES=60

# Margen de cortesia en minutos para el calculo de dias de alquiler.
# Un exceso por debajo de este margen no suma un dia mas.
RENTAL_COURTESY_MINUTES=59
# IVA por defecto del alquiler, en porcentaje.
DEFAULT_TAX_RATE=21.00

# --- Acceso ----------------------------------------------------------------
# Intentos fallidos (por combinacion IP + usuario) antes de bloquear.
AXES_FAILURE_LIMIT=5
# Minutos que dura el bloqueo.
AXES_COOLOFF_MINUTES=15
# Superusuario que crea `make seed`. Solo en desarrollo.
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=admin

# --- Correo (solo prod; en dev se imprime en consola) -----------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@localhost

# --- Seguridad en prod -----------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
