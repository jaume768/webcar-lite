# ---------------------------------------------------------------------------
# .env de produccion para docker-compose.prod.yml.
#   cp deploy/env.prod.example .env && chmod 600 .env
# Rellena todo lo marcado con CAMBIAR. El resto de variables (tarifas, SES,
# pasarelas, correo...) estan explicadas en .env.example y se anaden aqui.
# ---------------------------------------------------------------------------

# --- Red y dominio ---------------------------------------------------------
# Red Docker del Caddy que ya ocupa 80/443 (docker network ls).
PROXY_NETWORK=jaume-leveling_default
# Host publico: lo usa el healthcheck de la web para hablar como Caddy.
PUBLIC_HOST=rentflow.websjfs.com
PUBLIC_BASE_URL=https://rentflow.websjfs.com

# --- Django ----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CAMBIAR
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=rentflow.websjfs.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://rentflow.websjfs.com
DJANGO_LOG_FORMAT=json
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
# Procesos de gunicorn. 2 basta en un servidor de 1 vCPU y 2 GB.
GUNICORN_WORKERS=2

# --- Base de datos ---------------------------------------------------------
POSTGRES_DB=rentflow
POSTGRES_USER=rentflow
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CAMBIAR
DATABASE_URL=postgres://rentflow:CAMBIAR@rentflow-db:5432/rentflow
DATABASE_CONN_MAX_AGE=60

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://rentflow-redis:6379/0
CELERY_BROKER_URL=redis://rentflow-redis:6379/1
CELERY_RESULT_BACKEND=redis://rentflow-redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# --- Ficheros --------------------------------------------------------------
DJANGO_PRIVATE_MEDIA_ROOT=/app/private-media
MAX_UPLOAD_SIZE_MB=10

# --- Demostracion ----------------------------------------------------------
# True mientras la instalacion sea una demo publica con datos de ejemplo:
# permite `seed_demo` y ensena el acceso de un clic en la portada. Con clientes
# reales, False.
DEMO_MODE=True
DEMO_EMAIL=demo@webcar.example
DEMO_PASSWORD=demo-webcar-2026
CONTACT_WHATSAPP=683472110

# --- Dominio (obligatorias) ------------------------------------------------
RENTAL_COURTESY_MINUTES=59
DEFAULT_TAX_RATE=21.00

# --- Correo ----------------------------------------------------------------
# Sin BREVO_API_KEY ni EMAIL_HOST los correos al cliente fallan al enviarse.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@rentflow.websjfs.com
EMAIL_REPLY_TO=
